<Window x:Class="ShootSorter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShootSorter.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ShootSorter 攝影棚素材自動歸檔" Icon="Assets/ShootSorter.ico" Height="640" Width="1000" MinHeight="480" MinWidth="760"
        FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FDECEA" BorderBrush="#E57373" BorderThickness="0,0,0,1" Padding="12,8"
                Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Problems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat=⚠ {0}}" Foreground="#B71C1C" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding WatchStatus}" />
        </StatusBar>

        <TabControl Margin="8">
            <TabItem Header="歸檔紀錄" DataContext="{Binding Records}">
                <DockPanel Margin="12">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="結果" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"
                                  DisplayMemberPath="Label" Width="90" Margin="0,0,16,0" />
                        <TextBlock Text="處理日期" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <DatePicker SelectedDate="{Binding FromDate}" Width="130" SelectedDateFormat="Short" />
                        <TextBlock Text="～" VerticalAlignment="Center" Margin="6,0" />
                        <DatePicker SelectedDate="{Binding ToDate}" Width="130" SelectedDateFormat="Short" Margin="0,0,8,0" />
                        <Button Content="清除篩選" Command="{Binding ClearFilterCommand}" Padding="10,2" Margin="0,0,8,0" />
                        <Button Content="重新整理" Command="{Binding RefreshCommand}" Padding="10,2" />
                    </WrapPanel>

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="重試勾選項目" Command="{Binding RetrySelectedCommand}" Padding="12,3" Margin="0,0,8,0" />
                            <Button Content="全部失敗項目重試" Command="{Binding RetryAllFailedCommand}" Padding="12,3" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summary}" />
                            <TextBlock Text="{Binding RetryMessage}" Foreground="#1565C0" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Extended"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusText}" Value="失敗">
                                        <Setter Property="Background" Value="#FDECEA" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusText}" Value="略過">
                                        <Setter Property="Background" Value="#FFF8E1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="重試" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanRetry}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="處理時間" Binding="{Binding ProcessedAt, Mode=OneWay}" IsReadOnly="True" />
                            <DataGridTextColumn Header="結果" Binding="{Binding StatusText, Mode=OneWay}" IsReadOnly="True" />
                            <DataGridTextColumn Header="檔名" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" />
                            <DataGridTextColumn Header="EXIF" Binding="{Binding ExifText, Mode=OneWay}" IsReadOnly="True" />
                            <DataGridTextColumn Header="案件" Binding="{Binding CaseName, Mode=OneWay}" IsReadOnly="True" />
                            <DataGridTextColumn Header="拍攝時間" Binding="{Binding CapturedAt, Mode=OneWay}" IsReadOnly="True" />
                            <DataGridTextColumn Header="目的路徑" Binding="{Binding DestinationPath, Mode=OneWay}" IsReadOnly="True" MaxWidth="360" />
                            <DataGridTextColumn Header="原因" Binding="{Binding Reason, Mode=OneWay}" IsReadOnly="True" MaxWidth="360" />
                            <DataGridTextColumn Header="重試次數" Binding="{Binding RetryCount, Mode=OneWay}" IsReadOnly="True" />
                            <DataGridTextColumn Header="原始路徑" Binding="{Binding SourcePath, Mode=OneWay}" IsReadOnly="True" MaxWidth="320" />
                            <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256, Mode=OneWay}" IsReadOnly="True" MaxWidth="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="設定" DataContext="{Binding Settings}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="收件匣資料夾" VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InboxPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8" />
                    <Button Grid.Row="0" Grid.Column="2" Content="瀏覽…" Command="{Binding BrowseInboxCommand}" Padding="12,2" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Text="歸檔根目錄" VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ArchiveRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8" />
                    <Button Grid.Row="1" Grid.Column="2" Content="瀏覽…" Command="{Binding BrowseArchiveRootCommand}" Padding="12,2" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Text="排除副檔名" VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                             Text="{Binding ExcludedExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="以逗號分隔，例如 .xmp, .thm。列出的副檔名完全不處理，也不留紀錄。" />

                    <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,4">
                        <TextBlock Text="案件規則（由上往下比對，第一個符合者生效）" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="新增" Command="{Binding AddRuleCommand}" Padding="10,2" Margin="4,0" />
                            <Button Content="刪除" Command="{Binding RemoveRuleCommand}" Padding="10,2" Margin="4,0" />
                            <Button Content="上移" Command="{Binding MoveRuleUpCommand}" Padding="10,2" Margin="4,0" />
                            <Button Content="下移" Command="{Binding MoveRuleDownCommand}" Padding="10,2" Margin="4,0,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="4" Grid.ColumnSpan="3" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="檔名包含（不分大小寫）" Width="*"
                                                Binding="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="案件資料夾" Width="*"
                                                Binding="{Binding CaseName, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="5" Grid.ColumnSpan="3" HorizontalAlignment="Right" Content="儲存並套用"
                            Command="{Binding SaveCommand}" Padding="20,4" Margin="0,12,0,0" IsDefault="True" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
